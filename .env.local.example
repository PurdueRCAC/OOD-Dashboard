# Example site configuration for the HPC Dashboard.
#
# Copy to `.env.local` for local development. In production, prefer setting the
# same keys in `/etc/ood/config/apps/dashboard/env` (or as YAML keys without the
# `OOD_` prefix in `/etc/ood/config/apps/dashboard/*.yml`), so configuration
# lives outside the checkout and survives upgrades.
#
# Values below use Purdue's Gautschi cluster as a worked example -- replace them
# with your own. Every key is optional: features whose configuration is missing
# hide themselves or report "N/A" rather than breaking the page, so an
# unconfigured deployment still boots and behaves like the stock OOD dashboard.

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------

# Serve an invented cluster instead of talking to a scheduler, for evaluating
# the dashboard without Slurm. Opt-in, banners every page, never for
# production. See demo/README.md.
# OOD_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------

# Short name of this cluster or service. Used in page copy ("... on Demo"),
# the sidebar brand, and exported filenames. Defaults to the OOD dashboard
# title when unset.
OOD_SITE_NAME="Demo"

# Optional logo shown beside the site name in the sidebar. Omit for text only.
OOD_SITE_LOGO_URL=""

OOD_DASHBOARD_LOGO=/public/ood_logo.svg
OOD_DASHBOARD_LOGO_HEIGHT="100px"

# ---------------------------------------------------------------------------
# Documentation and support links
# ---------------------------------------------------------------------------

# General links. Both are standard OOD dashboard settings.
OOD_DASHBOARD_SUPPORT_URL="https://www.rcac.purdue.edu/help"
OOD_DASHBOARD_DOCS_URL="https://docs.rcac.purdue.edu/userguides/gautschi/"

# Topic-specific documentation, linked from the info icon on each widget. Any
# one of these falls back to OOD_DASHBOARD_DOCS_URL when unset; if that is also
# unset, the icon is not rendered at all.
OOD_DOCS_ACCOUNTS_URL="https://docs.rcac.purdue.edu/userguides/gautschi/run_jobs/queues/"
OOD_DOCS_PARTITIONS_URL="https://docs.rcac.purdue.edu/userguides/gautschi/run_jobs/queues/"
OOD_DOCS_STORAGE_URL="https://docs.rcac.purdue.edu/userguides/gautschi/storage/"
OOD_DOCS_NODES_URL="https://docs.rcac.purdue.edu/userguides/gautschi/overview/#gautschi-specifications"

# ---------------------------------------------------------------------------
# Announcements / news feed widget
# ---------------------------------------------------------------------------

# JSON endpoint for the announcements widget. Leave unset to disable the widget
# entirely. The expected response shape is documented in
# app/controllers/api/news_feed_controller.rb -- sites with a different news
# system will need to adapt that controller.
# e.g.
# OOD_NEWS_FEED_URL="https://www.rcac.purdue.edu/api/news?resource=113&limit=30"

# If the feed covers several clusters, keep only articles tagged with this
# resource name. Unset means keep every article the endpoint returns.
# e.g.
# OOD_NEWS_FEED_RESOURCE_FILTER="Demo"

# Human-facing news archive, linked as "View All" in the widget header.
# e.g.
# OOD_NEWS_PAGE_URL="https://www.rcac.purdue.edu/news/gautschi?state=all&order_dir=desc"

# ---------------------------------------------------------------------------
# Storage quotas
# ---------------------------------------------------------------------------

# Colon-separated JSON files or URLs in OOD's quota format.
OOD_QUOTA_PATH="https://www.rcac.purdue.edu/ws/storagedirquota/$USER"
OOD_QUOTA_THRESHOLD="0.90"

# Command the Storage widget runs to report filesystem quotas. It is given the
# username as its only argument. There is no portable way to ask a cluster this,
# so it is a site-local wrapper -- leave unset and the widget hides itself.
#
# Output must be whitespace-separated columns, after OOD_QUOTA_COMMAND_SKIP_LINES
# header rows:
#   type location disk_used disk_limit disk_pct files file_limit file_pct
# e.g.  home  /home/alice  38.2GB  100GB  38%  412031  1000000  41%
# See demo/bin/myquota for a worked example.
OOD_QUOTA_COMMAND="myquota"
OOD_QUOTA_COMMAND_SKIP_LINES="3"

# Scratch directory the storage widget links to, for quota rows of type
# "scratch". `$USER` is expanded to the current user. Other filesystem types
# fall back to /<type>/<location>.
OOD_SCRATCH_DIR_TEMPLATE="/scratch/demo/\$USER"

# ---------------------------------------------------------------------------
# Allocations / balances
# ---------------------------------------------------------------------------

# Colon-separated JSON files or URLs in OOD's balance format. These drive the
# stock OOD warning banner only -- the Accounts and Balance widgets read Slurm
# accounting directly, configured below.
OOD_BALANCE_PATH=""
OOD_BALANCE_THRESHOLD="0"

# Slurm records an allocation's balance under a TRES name, and which name
# depends on what the allocation is denominated in. Accounts whose name matches
# OOD_GPU_ACCOUNT_PATTERN are read from OOD_GPU_ACCOUNT_TRES; all others from
# OOD_CPU_ACCOUNT_TRES.
#
# The pattern is a regular expression matched against the account name, so
# "-gpu$" matches only a suffix while a bare "-gpu" matches anywhere. Leave it
# unset -- the default -- and every account is treated as CPU-denominated,
# which is right for sites that do not separate GPU allocations.
#
# Prefer "$" over "\\z" here: an unquoted OOD_GPU_ACCOUNT_PATTERN=-gpu\\z is
# parsed as the literal "-gpuz" and silently matches nothing.
OOD_GPU_ACCOUNT_PATTERN="-gpu$"
OOD_GPU_ACCOUNT_TRES="gres/gpu"
OOD_CPU_ACCOUNT_TRES="cpu"

# ---------------------------------------------------------------------------
# Partition and node status
# ---------------------------------------------------------------------------

# Comma-separated Slurm partitions to hide from the System Status widget --
# typically reservation-only, staff, or benchmarking partitions.
OOD_EXCLUDED_PARTITIONS="demo-nodes,profiling"

# ---------------------------------------------------------------------------
# GPU-hour accounting
# ---------------------------------------------------------------------------
#
# GPU-hour charging is site policy. Leave OOD_GPU_HOURS_PARTITIONS unset and
# every job reports GPU hours as "N/A" -- appropriate for sites that do not
# charge separately for GPU time.

# Comma-separated partitions that are charged for GPU hours.
OOD_GPU_HOURS_PARTITIONS="ai"

# Jobs with an id at or below this value predate the charging policy and are
# reported as "N/A". Set to 0 if the policy has always applied.
OOD_GPU_HOURS_MIN_JOB_ID="0"

# A QoS charged at a reduced rate, and the multiplier applied to it.
OOD_GPU_HOURS_DISCOUNTED_QOS="preemptible"
OOD_GPU_HOURS_DISCOUNTED_CHARGE_FACTOR="0.25"

# ---------------------------------------------------------------------------
# Per-job efficiency metrics (jobstats)
# ---------------------------------------------------------------------------
#
# Both values must be set for CPU/GPU utilization and memory efficiency to
# appear on job pages; unset, those columns are simply omitted.
#
# jobstats ships a `#!/usr/bin/env python3` shebang, which on the OOD PUN host
# often resolves to an interpreter without its `requests` dependency. Point
# OOD_JOBSTATS_PYTHON at an interpreter that has the dependencies and
# OOD_JOBSTATS_SCRIPT at the script itself; the dashboard invokes the latter as
# an argument to the former.
OOD_JOBSTATS_PYTHON="/apps/rcac/tools/libexec/bin/python3.13"
OOD_JOBSTATS_SCRIPT="/apps/rcac/tools/py/apps/jobstats/jobstats"

# ---------------------------------------------------------------------------
# Message of the day
# ---------------------------------------------------------------------------

MOTD_PATH=/etc/motd
MOTD_FORMAT="txt"

# ---------------------------------------------------------------------------
# Batch Connect
# ---------------------------------------------------------------------------

OOD_BC_DYNAMIC_JS=true
