<% if @featured_group.present? %>
  <% group = @featured_group %>
  <%= render partial: "layouts/nav/top/dropdown",
      locals: {
        icon_class: "fas fa-star",
        title: group.title,
        groups: OodAppGroup.groups_for(apps: group.apps, group_by: :subcategory, nav_limit: group.nav_limit)
      } %> 
<% end %>